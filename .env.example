DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Bogota
CORS_ALLOW_ALL_ORIGINS=True

DB_ENGINE=postgres
POSTGRES_DB=groupsapp
POSTGRES_USER=groupsapp
POSTGRES_PASSWORD=groupsapp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=groupsapp.events
RABBITMQ_ENABLED=True

AUTH_SERVICE_URL=http://127.0.0.1:8001
GROUP_SERVICE_URL=http://127.0.0.1:8002
MESSAGE_SERVICE_URL=http://127.0.0.1:8003
